# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase / PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]?sslmode=require
DATABASE_URL=YOUR_DATABASE_URL

# JWT Secrets
JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=5d
JWT_REFRESH_EXPIRES_IN=30d
JWT_RESET_PASS_SECRET=YOUR_RESET_PASS_SECRET
JWT_RESET_PASS_EXPIRES_IN=5m
RESET_PASS_LINK=http://localhost:3000/reset-password

# Bcrypt Salt Rounds
SALT_ROUNDS=12

# Initial Admin Credentials (Optional / Seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# Client / Frontend
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_FAIL_URL=http://localhost:3000/payment/fail
FRONTEND_CANCEL_URL=http://localhost:3000/payment/cancel

# Cloudinary (Optional / Media Storage)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Email Service (Nodemailer / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="Support <your_email@gmail.com>"

# Stripe (Optional / Payment)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Redis (Optional)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
